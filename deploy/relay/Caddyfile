{
	servers {
		# UDP 443 belongs to the relay's QUIC.
		protocols h1 h2
	}
}

{$RELAY_DOMAIN} {
	# Compress the dashboard's pages only: never the WebSocket fallback.
	@dashboard path /dashboard*
	encode @dashboard zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# sheprd.org/relay reads the relay's own answer here, so a relay that
	# is down behind a running Caddy does not look ready.
	@health path /healthz
	header @health Access-Control-Allow-Origin "*"
	# /v1/info, the dashboard, and the WebSocket fallback for networks
	# that block UDP. The relay sees ciphertext only.
	reverse_proxy relay:8080
}
